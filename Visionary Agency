.hero-bg { position: absolute; inset: 0px; background: radial-gradient(at 20% 50%, rgba(201, 168, 76, 0.12) 0%, transparent 60%), radial-gradient(at 80% 20%, rgba(201, 168, 76, 0.08) 0%, transparent 50%), radial-gradient(at 60% 80%, rgba(201, 168, 76, 0.06) 0%, transparent 40%); }

.hero-content { flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 120px 24px 60px; position: relative; }

.hero-badge { display: inline-block; border: 1px solid rgba(201, 168, 76, 0.4); color: var(--gold); font-family: Syne, sans-serif; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; padding: 8px 20px; margin-bottom: 32px; animation: 0.8s ease 0s 1 normal both running fadeUp; }

.hero-title { font-family: "Playfair Display", serif; font-size: clamp(3rem, 8vw, 6.5rem); font-weight: 900; line-height: 1.05; margin-bottom: 12px; animation: 0.8s ease 0.15s 1 normal both running fadeUp; }

.hero-title .gold { color: var(--gold); }

.hero-tagline { font-family: Syne, sans-serif; font-size: clamp(0.9rem, 2vw, 1.1rem); color: var(--grey); max-width: 620px; line-height: 1.7; margin-bottom: 48px; animation: 0.8s ease 0.3s 1 normal both running fadeUp; }

.hero-tagline strong { color: var(--gold-light); font-weight: 500; }

.posters-row { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; padding: 0px 24px 60px; position: relative; animation: 0.8s ease 0.45s 1 normal both running fadeUp; }

.poster { width: 200px; border: 1px solid rgba(201, 168, 76, 0.25); background: var(--dark3); padding: 24px 20px; position: relative; overflow: hidden; transition: transform 0.3s, border-color 0.3s; }

.poster:hover { transform: translateY(-6px); border-color: var(--gold); }

.poster::before { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 2px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }

.poster-tag { font-family: Syne, sans-serif; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }

.poster-brand { font-family: "Playfair Display", serif; font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; }

.poster-stats { font-size: 0.75rem; color: var(--grey); line-height: 1.6; }

.poster-stats strong { color: var(--gold-light); }

.poster-seal { margin-top: 14px; display: inline-block; background: rgba(201, 168, 76, 0.15); border: 1px solid rgba(201, 168, 76, 0.3); color: var(--gold); font-size: 0.65rem; font-family: Syne, sans-serif; letter-spacing: 0.1em; padding: 4px 10px; text-transform: uppercase; }

.founder-bar { border-top: 1px solid rgba(201, 168, 76, 0.15); padding: 32px 48px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; background: rgba(0, 0, 0, 0.3); animation: 0.8s ease 0.6s 1 normal both running fadeUp; }

.founder-info { display: flex; align-items: center; gap: 16px; }

.founder-avatar { width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, var(--gold), var(--dark4)); display: flex; align-items: center; justify-content: center; font-family: "Playfair Display", serif; font-size: 1.2rem; color: var(--dark); font-weight: 700; border: 2px solid var(--gold); }

.founder-text { font-size: 0.85rem; }

.founder-text strong { display: block; font-family: Syne, sans-serif; font-size: 0.9rem; color: var(--gold); }

.founder-text span { color: var(--grey); }

.contact-info { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }

.contact-item { font-size: 0.8rem; color: var(--grey); display: flex; align-items: center; gap: 8px; }

.contact-item .icon { color: var(--gold); font-size: 1rem; }

.contact-item a { color: var(--grey); text-decoration: none; transition: color 0.2s; }

.contact-item a:hover { color: var(--gold); }

#page2 { display: none; min-height: 100vh; }

#page2.active { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80px 24px; }

.choose-title { font-family: "Playfair Display", serif; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; text-align: center; margin-bottom: 16px; }

.choose-sub { color: var(--grey); font-family: Syne, sans-serif; text-align: center; margin-bottom: 60px; font-size: 0.95rem; letter-spacing: 0.05em; }

.choose-cards { display: flex; gap: 32px; flex-wrap: wrap; justify-content: center; max-width: 800px; }

.choose-card { width: 320px; border: 1px solid rgba(201, 168, 76, 0.2); background: var(--dark3); padding: 48px 36px; cursor: pointer; position: relative; overflow: hidden; transition: 0.4s; text-align: center; }

.choose-card::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(135deg, rgba(201, 168, 76, 0.05), transparent); opacity: 0; transition: opacity 0.4s; }

.choose-card:hover { border-color: var(--gold); transform: translateY(-8px); box-shadow: rgba(201, 168, 76, 0.1) 0px 20px 60px; }

.choose-card:hover::before { opacity: 1; }

.card-icon { font-size: 3rem; margin-bottom: 20px; display: block; }

.card-title { font-family: "Playfair Display", serif; font-size: 1.8rem; font-weight: 700; margin-bottom: 12px; color: var(--gold); }

.card-desc { font-size: 0.85rem; color: var(--grey); line-height: 1.7; margin-bottom: 28px; }

.card-btn { display: inline-block; background: transparent; border: 1px solid var(--gold); color: var(--gold); font-family: Syne, sans-serif; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 12px 28px; cursor: pointer; transition: 0.3s; }

.card-btn:hover { background: var(--gold); color: var(--dark); }

