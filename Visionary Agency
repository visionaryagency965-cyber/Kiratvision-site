.empty-state { text-align: center; padding: 60px; color: var(--grey); font-family: Syne, sans-serif; font-size: 0.9rem; letter-spacing: 0.05em; }

.empty-state .big { font-size: 3rem; display: block; margin-bottom: 16px; }

@keyframes fadeUp { 
  0% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes pulse { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

@media (max-width: 600px) {
  nav { padding: 16px 20px; }
  .founder-bar { padding: 24px 20px; }
  .form-container { padding: 32px 24px; }
  .choose-card { width: 100%; }
  .admin-tab { padding: 12px 18px; }
}
