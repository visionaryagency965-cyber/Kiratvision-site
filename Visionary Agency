.form-container { width: 100%; max-width: 560px; background: var(--dark3); border: 1px solid rgba(201, 168, 76, 0.2); padding: 48px 40px; position: relative; }

.form-container::before { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 3px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }

.form-eyebrow { font-family: Syne, sans-serif; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }

.form-title { font-family: "Playfair Display", serif; font-size: 2rem; font-weight: 700; margin-bottom: 8px; }

.form-sub { font-size: 0.85rem; color: var(--grey); margin-bottom: 36px; line-height: 1.6; }

.field { margin-bottom: 20px; }

.field label { display: block; font-family: Syne, sans-serif; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; }

.field input, .field select, .field textarea { width: 100%; background: var(--dark4); border: 1px solid rgba(201, 168, 76, 0.2); color: var(--white); font-family: "DM Sans", sans-serif; font-size: 0.9rem; padding: 12px 16px; outline: none; transition: border-color 0.3s; appearance: none; }

.field input::placeholder, .field textarea::placeholder { color: rgb(85, 85, 85); }

.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--gold); background: rgba(201, 168, 76, 0.04); }

.field select option { background: var(--dark4); }

.submit-btn { width: 100%; background: var(--gold); color: var(--dark); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 16px; font-family: Syne, sans-serif; font-weight: 800; font-size: 0.9rem; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; margin-top: 8px; transition: 0.3s; }

.submit-btn:hover { background: var(--gold-light); transform: translateY(-1px); }

.back-link { display: inline-block; margin-top: 20px; color: var(--grey); font-size: 0.8rem; cursor: pointer; font-family: Syne, sans-serif; letter-spacing: 0.05em; transition: color 0.2s; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; text-decoration: underline; }

.back-link:hover { color: var(--gold); }

#page4-creator, #page4-brand { display: none; min-height: 100vh; align-items: center; justify-content: center; text-align: center; padding: 60px 24px; }

#page4-creator.active, #page4-brand.active { display: flex; flex-direction: column; }

.thankyou-wrap { max-width: 560px; }

.thankyou-icon { font-size: 4rem; margin-bottom: 24px; display: block; animation: 2s ease 0s infinite normal none running pulse; }

.thankyou-title { font-family: "Playfair Display", serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: var(--gold); margin-bottom: 16px; }

.thankyou-msg { font-size: 1rem; color: var(--grey); line-height: 1.8; margin-bottom: 36px; }

.whatsapp-btn { display: inline-flex; align-items: center; gap: 12px; background: rgb(37, 211, 102); color: rgb(255, 255, 255); text-decoration: none; padding: 16px 32px; font-family: Syne, sans-serif; font-weight: 700; font-size: 0.9rem; letter-spacing: 0.08em; transition: 0.3s; margin-bottom: 16px; }

.whatsapp-btn:hover { background: rgb(30, 190, 90); transform: translateY(-2px); box-shadow: rgba(37, 211, 102, 0.3) 0px 8px 30px; }

#admin-login { display: none; min-height: 100vh; align-items: center; justify-content: center; padding: 60px 24px; }

#admin-login.active { display: flex; }

#admin-panel { display: none; min-height: 100vh; padding: 80px 24px 60px; }

#admin-panel.active { display: block; }

.admin-title { font-family: "Playfair Display", serif; font-size: 2rem; color: var(--gold); margin-bottom: 40px; text-align: center; }

.admin-tabs { display: flex; gap: 0px; margin-bottom: 32px; border-bottom: 1px solid rgba(201, 168, 76, 0.2); }

.admin-tab { padding: 12px 32px; font-family: Syne, sans-serif; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: 0.3s; color: var(--grey); background: none; border-width: medium medium 2px; border-style: none none solid; border-color: currentcolor currentcolor transparent; border-image: initial; }

.admin-tab.active { color: var(--gold); border-bottom-color: var(--gold); }

.admin-section { display: none; }

.admin-section.active { display: block; }

.records-grid { display: grid; gap: 16px; }

.record-card { background: var(--dark3); border: 1px solid rgba(201, 168, 76, 0.15); padding: 20px 24px; position: relative; }

