@charset "utf-8";

:root { --gold: #C9A84C; --gold-light: #F0D080; --dark: #0A0A0A; --dark2: #111111; --dark3: #1A1A1A; --dark4: #222222; --white: #F5F0E8; --grey: #888888; --success: #2ECC71; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { background: var(--dark); color: var(--white); font-family: "DM Sans", sans-serif; overflow-x: hidden; }

